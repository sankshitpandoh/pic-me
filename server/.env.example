# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used for persona replies. Default is claude-opus-5-5.
# claude-haiku-4-5 is much cheaper per message; see README before switching.
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
HISTORY_LIMIT=40

PORT=4000
# Set to "production" to disable dev-only features (OTP in responses, free top-ups).
NODE_ENV=development

# Razorpay (leave empty to use free dev top-ups locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
